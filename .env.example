# Docker publishes the API only on the local host by default.
AGENT_BIND=127.0.0.1
AGENT_PORT=8000
# Initial budget for the Python agent only, NOT the host llama-server.
AGENT_MEMORY_LIMIT=768m
AGENT_CPU_LIMIT=1.0

# Master switch for all LLM calls. Fixture diagnostics work without a model.
LLM_ENABLED=false
# Local RPi llama-server. Native Python: use http://127.0.0.1:8080/v1 instead.
LLM_BASE_URL=http://host.docker.internal:8080/v1
# Match the model ID returned by /v1/models, or start llama-server with --alias local-qwen.
LLM_MODEL=local-qwen
LLM_API_KEY=not-required
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=256

# Optional Pamout escalation: https://signup.pamout.com/api-docs.html
# When enabled, auto uses Pamout for error-severity findings or local failure.
# A request can also set llm_target=local or external; explicit local never escalates.
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_BASE_URL=https://llm.pamout.com/v1
# Documentation example; confirm the exact ID with authenticated GET /v1/models.
EXTERNAL_LLM_MODEL=glm-5.3
# Put your personal key in the untracked .env, never in this example file.
EXTERNAL_LLM_API_KEY=
# Pamout requires a meaningful User-Agent.
EXTERNAL_LLM_USER_AGENT=rpi5-diagnostic-agent/0.1.0
EXTERNAL_LLM_TIMEOUT_SECONDS=120
EXTERNAL_LLM_MAX_TOKENS=4096
# prompt: request JSON in the prompt, then validate the same strict schema locally.
# json_object/json_schema: opt in only after verifying backend support.
EXTERNAL_LLM_RESPONSE_FORMAT=prompt
EXTERNAL_LLM_FALLBACK_ON_LOCAL_FAILURE=true

LANGSMITH_TRACING=false

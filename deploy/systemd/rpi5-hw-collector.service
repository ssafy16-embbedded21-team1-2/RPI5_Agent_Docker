[Unit]
Description=RPi5 Agent Phase 1 Host Hardware Collector
Requires=docker.service
After=docker.service rpi5-can0.service
Wants=rpi5-can0.service
PartOf=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/RPI5_Agent_Docker
ExecStart=/usr/local/libexec/run_rpi5_hw_collector_service.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
